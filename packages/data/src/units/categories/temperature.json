{
  "id": "temperature",
  "name": "Temperature",
  "si_base": "kelvin",
  "conversion_type": "formula",
  "units": [
    {
      "id": "celsius",
      "name": "Celsius",
      "symbol": "°C",
      "to_kelvin": "x + 273.15",
      "from_kelvin": "x - 273.15"
    },
    {
      "id": "delisle",
      "name": "Delisle",
      "symbol": "°De",
      "to_kelvin": "373.15 - x * 2/3",
      "from_kelvin": "(373.15 - x) * 3/2"
    },
    {
      "id": "fahrenheit",
      "name": "Fahrenheit",
      "symbol": "°F",
      "to_kelvin": "(x + 459.67) * 5/9",
      "from_kelvin": "x * 9/5 - 459.67"
    },
    {
      "id": "kelvin",
      "name": "Kelvin",
      "symbol": "K",
      "to_kelvin": "x",
      "from_kelvin": "x"
    },
    {
      "id": "newton_temp",
      "name": "Newton (temperature)",
      "symbol": "°N",
      "to_kelvin": "x * 100/33 + 273.15",
      "from_kelvin": "(x - 273.15) * 33/100"
    },
    {
      "id": "planck_temp",
      "name": "Planck Temperature",
      "symbol": "TP",
      "to_kelvin": "x * 1.417e32",
      "from_kelvin": "x / 1.417e32"
    },
    {
      "id": "rankine",
      "name": "Rankine",
      "symbol": "°R",
      "to_kelvin": "x * 5/9",
      "from_kelvin": "x * 9/5"
    },
    {
      "id": "reaumur",
      "name": "Réaumur",
      "symbol": "°Ré",
      "to_kelvin": "x * 5/4 + 273.15",
      "from_kelvin": "(x - 273.15) * 4/5"
    },
    {
      "id": "romer",
      "name": "Rømer",
      "symbol": "°Rø",
      "to_kelvin": "(x - 7.5) * 40/21 + 273.15",
      "from_kelvin": "(x - 273.15) * 21/40 + 7.5"
    },
    {
      "id": "gas_mark",
      "name": "Gas mark (oven)",
      "symbol": "GM"
    },
    {
      "id": "triple_point_water",
      "name": "Triple point of water",
      "symbol": "Ttp"
    }
  ]
}
