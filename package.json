{
  "name": "conv.cat",
  "private": true,
  "description": "conv.cat monorepo root — pnpm workspace covering apps/* and packages/*. See README.md for the full layout.",
  "license": "(MIT AND AGPL-3.0-only)",
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "build:all": "./scripts/build-all.sh",
    "check": "./scripts/build-all.sh --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "generate:units": "node scripts/generate-units-catalog.mjs",
    "wasm:report": "node scripts/wasm-report.mjs --build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "clean": "pnpm -r --if-present run clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
